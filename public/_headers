# Cloudflare Pages headers for the Gaydio website.
#
# Hidden while it is being built: X-Robots-Tag on every response keeps the
# preview address out of search engines even where a page's own noindex tag
# is missed (a redirect, a file). Remove the X-Robots-Tag line in the launch
# build, together with robots.txt.
#
# The CSP allows this site, the hub's picture library and Cloudflare's
# analytics beacon, and nothing else. Custom HTML blocks that need a third
# party (an ad tag, an embedded player) will each add their host here when
# they are built: a frame or script blocked by CSP fails silently.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://media.gaydio.link; style-src 'self'; script-src 'self' https://static.cloudflareinsights.com; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; form-action 'self'; base-uri 'self'; frame-ancestors 'none'

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=86400

/assets/css/*
  Cache-Control: public, max-age=3600

/assets/js/*
  Cache-Control: public, max-age=3600
